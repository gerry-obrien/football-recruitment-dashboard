        <calculation class='tableau' formula='IF [metric] = &quot;npxg_per90&quot; THEN &quot;Non-Pen xG per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;xag_per90&quot; THEN &quot;xA per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;ast_per90&quot; THEN &quot;Assists per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;prog_carries_per90&quot; THEN &quot;Progressive Carries per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;prog_passes_per90&quot; THEN &quot;Progressive Passes per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;prog_receptions_per90&quot; THEN &quot;Progressive Receptions per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;key_passes_per90&quot; THEN &quot;Key Passes per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;tackles_per90&quot; THEN &quot;Tackles per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;interceptions_per90&quot; THEN &quot;Interceptions per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;clearances_per90&quot; THEN &quot;Clearances per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;errors_per90&quot; THEN &quot;Errors per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;goals_non_pen_per90&quot; THEN &quot;Non-Pen Goals per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;save_pct&quot; THEN &quot;Save %&quot;&#13;&#10;ELSEIF [metric] = &quot;cs_pct&quot; THEN &quot;Clean Sheet %&quot;&#13;&#10;ELSEIF [metric] = &quot;ga_per90&quot; THEN &quot;Goals Allowed per 90&quot;&#13;&#10;ELSEIF [metric] = &quot;xg_per90&quot; THEN &quot;xG per 90&quot;&#13;&#10;END' />
      </column>
