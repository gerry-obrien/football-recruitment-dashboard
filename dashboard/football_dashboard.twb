  <actions>
    <action caption='Country Click' name='[Action1_86D01BC7F85E45A395951D50A0F68C29]'>
      <activation type='on-select' />
      <source dashboard='Nationality Talent Map' type='sheet' worksheet='Nationality Map' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Nationality Map' />
        <param name='special-fields' value='all' />
        <param name='target' value='Nationality Talent Map' />
      </command>
    </action>
    <action caption='Select Player' name='[Action2_88394586A7E14B51BB9BF50852D985A0]'>
      <activation auto-clear='true' type='on-select' />
      <source type='sheet' worksheet='Player Value Scanner' />
      <link caption='Select Player' delimiter=',' escape='\' expression='tsl:Player%20Percentile%20Profile?%5Bfederated.0exth6w0gdrxh217og0ug03z14j4%5D.%5Bplayer_id%20%28fbref_radar.csv%29%5D~s0=&lt;[federated.0exth6w0gdrxh217og0ug03z14j4].[player_id]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='target' value='Player Percentile Profile' />
      </command>
    </action>
    <action caption='Filter 1 (generated)' name='[Action4_6EC82AFD71F74705BDE3BC54E888519C]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Player Value Scanner Dash' type='sheet' worksheet='Player Value Scanner' />
